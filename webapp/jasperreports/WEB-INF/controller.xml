<site-conf xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://ofbiz.apache.org/Site-Conf" xsi:schemaLocation="http://ofbiz.apache.org/Site-Conf http://ofbiz.apache.org/dtds/site-conf.xsd">
    <include location="component://common/webcommon/WEB-INF/common-controller.xml"/>

    <description>JasperReports Component Site Configuration File</description>

    <!-- Generic JasperReports view handler: renders a .jrxml/.jasper template
         (identified by the view-map "page" or the "jrTemplate" request
         parameter) to PDF/CSV/XML. -->
    <handler name="jasperreports" type="view" class="org.apache.ofbiz.jasperreports.webapp.view.JasperReportsViewHandler"/>

    <!-- Request Mappings -->
    <request-map uri="main">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="main"/>
    </request-map>

    <!-- Generic report rendering request. The report template is passed via the
         "jrTemplate" request parameter (an OFBiz component:// location), the
         output format via the optional "jrContentType" parameter. -->
    <request-map uri="RunReport">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="RunReport"/>
    </request-map>

    <!-- Sample report, wired to a fixed template, for verifying the view handler. -->
    <request-map uri="SampleReport">
        <security https="true" auth="true"/>
        <response name="success" type="view" value="SampleReport"/>
    </request-map>

    <!-- View Mappings -->
    <view-map name="main" type="screen" page="component://jasperreports/widget/JasperReportsScreens.xml#main"/>

    <!-- Generic report view: template comes from the jrTemplate request
         parameter, defaults to PDF output. -->
    <view-map name="RunReport" type="jasperreports" content-type="application/pdf"/>

    <!-- Sample report view: fixed template, PDF output. -->
    <view-map name="SampleReport" type="jasperreports"
            page="component://jasperreports/webapp/jasperreports/reports/SampleReport.jrxml"
            content-type="application/pdf"/>
</site-conf>
